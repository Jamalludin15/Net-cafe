<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Tambah Admin | NETCAFE</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <div class="app-shell">
      <%- include('../partials/admin-sidebar', { path: path || '/admin/accounts' }) %>
      <main class="content-area">
        <header class="topbar"><div><p class="eyebrow">AKSES SISTEM</p><h1>Tambah akun admin</h1></div></header>
        <% if (error) { %><p class="form-error"><%= error %></p><% } %>
        <section class="panel"><form method="post" action="/admin/accounts">
          <label for="username">Username</label><input id="username" name="username" value="<%= values.username || '' %>" required>
          <label for="email">Email</label><input id="email" name="email" type="email" value="<%= values.email || '' %>" required>
          <label for="password">Password</label><input id="password" name="password" type="password" minlength="12" autocomplete="new-password" required>
          <div class="button-row"><button class="btn btn-primary" type="submit">Buat akun</button><a class="btn btn-secondary" href="/admin/accounts">Batal</a></div>
        </form></section>
      </main>
    </div>
  </body>
</html>