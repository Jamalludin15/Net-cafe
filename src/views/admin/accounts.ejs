<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Akun Admin | NETCAFE</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <div class="app-shell">
      <%- include('../partials/admin-sidebar', { path: path || '/admin/accounts' }) %>
      <main class="content-area">
        <header class="topbar"><div><p class="eyebrow">AKSES SISTEM</p><h1>Akun admin</h1></div><a class="btn btn-primary" href="/admin/accounts/new">Tambah admin</a></header>
        <section class="panel"><div class="table-wrap"><table>
          <thead><tr><th>Username</th><th>Email</th><th>Status</th><th>Dibuat</th></tr></thead>
          <tbody><% users.forEach((user) => { %><tr><td><%= user.username %></td><td><%= user.email %></td><td><%= user.is_active ? 'Aktif' : 'Nonaktif' %></td><td><%= new Date(user.created_at).toLocaleString('id-ID') %></td></tr><% }) %></tbody>
        </table></div></section>
      </main>
    </div>
  </body>
</html>