<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Booking management | NETCAFE</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <main class="wide-page">
      <a class="brand" href="/admin/dashboard">NETCAFE</a>
      <p class="eyebrow">ADMIN</p>
      <h1>Booking management</h1>
      <nav class="page-nav"><a href="/admin/dashboard">Dashboard</a><a href="/admin/computers">Computers</a></nav>
      <form class="filter-form" method="get" action="/admin/bookings">
        <label for="status">Status</label>
        <select id="status" name="status"><option value="">All</option><% ['PENDING', 'CONFIRMED', 'CANCELLED', 'COMPLETED'].forEach((option) => { %><option value="<%= option %>" <%= status === option ? 'selected' : '' %>><%= option %></option><% }) %></select>
        <button class="secondary-button" type="submit">Filter</button>
      </form>
      <div class="table-wrap">
        <table>
          <thead><tr><th>ID</th><th>Customer</th><th>Computer</th><th>Start</th><th>End</th><th>Status</th><th>Update</th></tr></thead>
          <tbody>
            <% bookings.forEach((booking) => { %>
              <tr>
                <td><%= booking.id %></td>
                <td><%= booking.username %><br><small><%= booking.email %></small></td>
                <td><%= booking.computer_code %></td>
                <td><%= new Date(booking.start_time).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' }) %></td>
                <td><%= new Date(booking.end_time).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' }) %></td>
                <td><%= booking.status %></td>
                <td><form class="inline-form" method="post" action="/admin/bookings/<%= booking.id %>/status"><select name="status"><% ['PENDING', 'CONFIRMED', 'CANCELLED', 'COMPLETED'].forEach((option) => { %><option value="<%= option %>" <%= booking.status === option ? 'selected' : '' %>><%= option %></option><% }) %></select><button class="link-button" type="submit">Save</button></form></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </body>
</html>
