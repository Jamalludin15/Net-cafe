<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Computer | NETCAFE</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <main class="auth-page">
      <a class="brand" href="/admin/computers">NETCAFE</a>
      <p class="eyebrow">ADMIN</p>
      <h1><%= computer.id ? 'Edit computer' : 'Add computer' %></h1>
      <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
      <form method="post" action="<%= action %>">
        <label for="computer_code">Computer code</label>
        <input id="computer_code" name="computer_code" required maxlength="30" value="<%= computer.computer_code || computer.code || '' %>" <%= computer.id ? 'readonly' : '' %>>
        <label for="name">Name</label>
        <input id="name" name="name" required maxlength="100" value="<%= computer.name || '' %>">
        <label for="hourly_rate">Hourly rate</label>
        <input id="hourly_rate" name="hourly_rate" type="number" min="0" step="0.01" required value="<%= computer.hourly_rate || computer.rate || '' %>">
        <label for="status">Status</label>
        <select id="status" name="status" required>
          <% ['AVAILABLE', 'IN_USE', 'MAINTENANCE'].forEach((status) => { %><option value="<%= status %>" <%= (computer.status || 'AVAILABLE') === status ? 'selected' : '' %>><%= status %></option><% }) %>
        </select>
        <% if (computer.id) { %>
          <input type="hidden" name="is_active" value="false">
          <label class="checkbox-label"><input type="checkbox" name="is_active" value="true" <%= computer.is_active ? 'checked' : '' %>> Active</label>
        <% } %>
        <button type="submit">Save computer</button>
      </form>
    </main>
  </body>
</html>
