<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Computer management | NETCAFE</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <main class="wide-page">
      <a class="brand" href="/admin/dashboard">NETCAFE</a>
      <p class="eyebrow">ADMIN</p>
      <h1>Computer management</h1>
      <nav class="page-nav"><a href="/admin/dashboard">Dashboard</a><a href="/admin/bookings">Bookings</a><a href="/admin/computers/new">Add computer</a></nav>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Code</th><th>Name</th><th>Status</th><th>Hourly rate</th><th>Active</th><th></th></tr></thead>
          <tbody>
            <% computers.forEach((computer) => { %>
              <tr>
                <td><%= computer.computer_code %></td>
                <td><%= computer.name %></td>
                <td><%= computer.status %></td>
                <td><%= Number(computer.hourly_rate).toLocaleString('id-ID') %></td>
                <td><%= computer.is_active ? 'Yes' : 'No' %></td>
                <td><a href="/admin/computers/<%= computer.id %>/edit">Edit</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </body>
</html>
