<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Pelanggan | NETCAFE</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <div class="app-shell">
      <%- include('../partials/admin-sidebar', { path: path || '/admin/customers' }) %>
      <main class="content-area">
        <header class="topbar">
          <div>
            <p class="eyebrow">ADMIN</p>
            <h1>Pelanggan</h1>
          </div>
        </header>
        <section class="panel">
          <div class="table-wrap">
            <table>
              <thead>
                <tr><th>ID</th><th>Username</th><th>Email</th><th>Role</th><th>Status</th><th>Created</th><th>Action</th></tr>
              </thead>
              <tbody>
                <% users.forEach((user) => { %>
                  <tr>
                    <td><%= user.id %></td>
                    <td><%= user.username %></td>
                    <td><%= user.email %></td>
                    <td><%= user.role %></td>
                    <td><span class="status-badge status-available"><%= user.is_active ? 'Active' : 'Inactive' %></span></td>
                    <td><%= new Date(user.created_at).toLocaleString('id-ID') %></td>
                    <td class="action-cell"><a class="btn btn-secondary" href="/admin/customers/<%= user.id %>">Lihat</a></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
