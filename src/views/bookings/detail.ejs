<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Booking detail | NETCAFE</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <main class="dashboard-page">
      <a class="brand" href="/bookings">NETCAFE</a>
      <p class="eyebrow">BOOKING</p>
      <h1>Booking #<%= booking.id %></h1>
      <dl class="account-details">
        <div><dt>Computer</dt><dd><%= booking.computer_code %> · <%= booking.name %></dd></div>
        <div><dt>Start</dt><dd><%= new Date(booking.start_time).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' }) %></dd></div>
        <div><dt>End</dt><dd><%= new Date(booking.end_time).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' }) %></dd></div>
        <div><dt>Status</dt><dd><%= booking.status %></dd></div>
        <div><dt>Estimated total</dt><dd><%= Number(booking.total).toLocaleString('id-ID') %></dd></div>
      </dl>
      <p class="form-footer"><a href="/bookings">Back to bookings</a></p>
    </main>
  </body>
</html>
