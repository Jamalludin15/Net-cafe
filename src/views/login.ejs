<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Log in | NETCAFE</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <main class="auth-page">
      <a class="brand" href="/">NETCAFE</a>
      <h1>Welcome back</h1>
      <p class="intro">Log in to your NETCAFE account.</p>
      <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
      <form method="post" action="/login">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required value="<%= email %>">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
        <button type="submit">Log in</button>
      </form>
      <p class="form-footer">New to NETCAFE? <a href="/register">Create an account</a></p>
    </main>
  </body>
</html>